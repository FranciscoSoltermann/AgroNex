# -----------------------------------------------------------------------------
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO - BACKEND
# -----------------------------------------------------------------------------
# Instrucciones para despliegue en Render:
# 1. Copia estas variables en "Environment Variables" del Web Service en Render.
# 2. Reemplaza los valores con las credenciales reales de tu Supabase de Producción.
# -----------------------------------------------------------------------------

# Perfil de Spring Boot (Activar producción)
SPRING_PROFILES_ACTIVE=prod

# Base de Datos (PostgreSQL Supabase)
# Formato: jdbc:postgresql://aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://[host]:[puerto]/[bd]?sslmode=require
SPRING_DATASOURCE_USERNAME=[usuario-bd]
SPRING_DATASOURCE_PASSWORD=[password-bd]

# Seguridad JWT y Supabase
SUPABASE_JWT_SECRET=[tu-jwt-secret-de-supabase]
CORS_ALLOWED_ORIGINS=https://agronex.vercel.app

# Integraciones de Terceros
JOHN_DEERE_CLIENT_ID=[client_id]
JOHN_DEERE_CLIENT_SECRET=[client_secret]
MERCADOPAGO_ACCESS_TOKEN=[access_token_mp]
MERCADOPAGO_PUBLIC_KEY=[public_key_mp]
MERCADOPAGO_WEBHOOK_SECRET=[webhook_secret]