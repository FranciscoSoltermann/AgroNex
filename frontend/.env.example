# -----------------------------------------------------------------------------
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO - FRONTEND
# -----------------------------------------------------------------------------
# Instrucciones para despliegue en Vercel:
# 1. Copia estas variables en el panel "Environment Variables" de Vercel.
# 2. Reemplaza los valores con tus credenciales de producción.
# 3. La API URL debe apuntar a tu backend hosteado (ej. en Render).
# -----------------------------------------------------------------------------

# Supabase (Auth y Base de Datos Pública)
NEXT_PUBLIC_SUPABASE_URL=https://[tu-proyecto-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...[tu-anon-key]

# Backend API
# En desarrollo: http://localhost:8080/api
# En producción: https://agronex-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://agronex-backend.onrender.com/api
