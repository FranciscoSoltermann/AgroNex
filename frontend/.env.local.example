# La URL de tu API de Java
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Las credenciales públicas de Supabase (las sacás de Settings -> API en Supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Clave de API del clima (ej: OpenWeatherMap)
NEXT_PUBLIC_WEATHER_API_KEY=your_weather_api_key_here

# Credenciales públicas de MercadoPago
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key_here
